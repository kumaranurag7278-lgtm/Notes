    },
    {
      "id": "z3LX-E0IV0bV2rYlqAl73",
      "type": "text",
      "x": 1965.1013782287218,
      "y": 1047.4281859745643,
      "width": 357.3359069824219,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
