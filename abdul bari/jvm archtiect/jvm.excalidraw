    {
      "id": "ZhJrWfSxiZu2S1XZMXIaQ",
      "type": "text",
      "x": 2656.558535405674,
      "y": 2962.548050011331,
      "width": 381.0599365234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
