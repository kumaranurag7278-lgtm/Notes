      "link": null,
      "locked": false,
      "text": "class KeybRead\n{\n    public static void main(String args[])\n    {\n        Scanner s = new Scanner(System.in);\n        int a,b,c;\n        System.out.println(\"Enter 2 numbers\");\n        a = s.nextInt();\n        b = s.nextInt();\n        c = a+b;\n        System.out.println(\"the sum of 2 numbers is \"+ c);\n\n    }\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class KeybRead\n{\n    public static void main(String args[])\n    {\n        Scanner s = new Scanner(System.in);\n        int a,b,c;\n        System.out.println(\"Enter 2 numbers\");\n        a = s.nextInt();\n        b = s.nextInt();\n        c = a+b;\n        System.out.println(\"the sum of 2 numbers is \"+ c);\n\n    }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
